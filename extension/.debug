<?xml version="1.0" encoding="UTF-8"?>
<!-- Remote DevTools for development: open http://localhost:8733 in Chrome while the panel is open. -->
<ExtensionList>
  <Extension Id="com.simplify.ae.panel">
    <HostList>
      <Host Name="AEFT" Port="8733"/>
    </HostList>
  </Extension>
</ExtensionList>
