<?xml version="1.0" encoding="UTF-8"?>
<!-- Simplify — After Effects workflow panel (CEP). AE 2023 (23.0) and newer. -->
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.simplify.ae"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Simplify"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.simplify.ae.panel" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- AEFT 23.0 = After Effects 2023. Upper bound left open for future versions. -->
      <Host Name="AEFT" Version="[23.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.simplify.ae.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node is used for file storage, speech-to-text and AI requests. -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Simplify</Menu>
          <Geometry>
            <Size><Height>680</Height><Width>380</Width></Size>
            <MinSize><Height>320</Height><Width>240</Width></MinSize>
            <MaxSize><Height>4000</Height><Width>4000</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
